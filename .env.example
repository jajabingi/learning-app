# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Optional: enables AI features (kept on the server only)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
ALLOW_REGISTRATION=true
WEB_PORT=8080

# --- Sign-in & accounts -------------------------------------------------------
# Public URL of the web app (links in emails and the Google redirect point here)
FRONTEND_URL=http://localhost:5174
# Google Sign-In (see docs/AUTH.md). Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an "Authorized redirect URI" in the Google Cloud console, exactly
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# true: new e-mail accounts stay "pending_verification" until they open the emailed link
REQUIRE_EMAIL_VERIFICATION=false
# Outgoing email (password reset, verification, Google link confirmation). Without SMTP_HOST links are only logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Recall <no-reply@example.com>

# First-run admin without a shell (created only if the database has no admin yet). Remove the password afterwards.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
